# =====================================================================
#  PVModern Magento 2 — production docker-compose environment
# =====================================================================
#  Copy to .env (the file docker-compose auto-reads) and fill in real
#  values BEFORE `docker compose up`. NEVER commit the populated .env.
#
#  Generate strong random secrets with:
#    openssl rand -base64 32
# =====================================================================

# ── Public hostname (must already point at this server via DNS A/AAAA)
MAGENTO_DOMAIN=pvmodern.example.com
MAGENTO_BASE_URL=https://pvmodern.example.com/

# ── Let's Encrypt — used for the initial cert issuance
LETSENCRYPT_EMAIL=you@example.com

# ── MySQL (read by the db container AND by the app entrypoint)
MYSQL_ROOT_PASSWORD=replace-with-openssl-rand-base64-32
MYSQL_DATABASE=magento
MYSQL_USER=magentouser
MYSQL_PASSWORD=replace-with-another-openssl-rand-base64-32

# ── Magento admin (used only on the very first boot to bootstrap)
ADMIN_USER=admin
ADMIN_PASSWORD=ChangeMe-2026!LongPasswordWithMixedCase
ADMIN_EMAIL=admin@example.com
ADMIN_FIRSTNAME=Admin
ADMIN_LASTNAME=User
ADMIN_FRONTNAME=admin_7sbaz51

# ── PVModern realtime pages
# News: VnExpress business RSS. Currency: Vietcombank XML. Weather: OpenWeatherMap.
VNEXPRESS_BUSINESS_RSS_URL=https://vnexpress.net/rss/kinh-doanh.rss
VIETCOMBANK_RATES_URL=https://portal.vietcombank.com.vn/Usercontrols/TVPortal.TyGia/pXML.aspx?b=68
OPENWEATHER_API_KEY=
OPENWEATHER_API_BASE_URL=https://api.openweathermap.org
WEATHER_API_KEY=

# ── Payment providers
PVMODERN_PAYMENT_MOCK=false
PVMODERN_CHECKOUT_MOCK=false
PVMODERN_PAYMENT_DEMO=false
PVMODERN_PUBLIC_BASE_URL=https://pvmodern.example.com

# MoMo
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
# VNPay
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Common payment
PAYMENT_RETURN_URL=https://pvmodern.example.com/payment/return
PAYMENT_WEBHOOK_SECRET=

# SePay / Casso (bank-transfer auto-confirmation)
SEPAY_API_KEY=
SEPAY_SANDBOX_API_KEY=
SEPAY_API_TOKEN=
SEPAY_SANDBOX_MODE=false
CASSO_WEBHOOK_SECRET=
