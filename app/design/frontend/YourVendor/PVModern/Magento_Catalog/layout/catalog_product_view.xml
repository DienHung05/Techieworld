<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="css/pv-product-view-fix.css"/>
    </head>
    <body>
        <!-- Remove star-rating review summary shown under product title -->
        <referenceBlock name="product.info.review" remove="true" />

        <!-- Remove SKU code shown next to "In stock" label -->
        <referenceBlock name="product.info.sku" remove="true" />

        <!-- Add a dedicated Specifications tab (shows specs once, not in Reviews) -->
        <referenceBlock name="product.info.details">
            <block class="Magento\Catalog\Block\Product\View"
                   name="pvmodern.product.specifications"
                   as="specifications"
                   template="Magento_Catalog::product/view/specifications.phtml"
                   group="detailed_info"
                   before="-">
                <arguments>
                    <argument name="title" xsi:type="string" translate="true">Specifications</argument>
                    <argument name="sort_order" xsi:type="string">5</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
