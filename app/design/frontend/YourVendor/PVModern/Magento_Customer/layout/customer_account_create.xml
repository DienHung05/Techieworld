<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd"
      layout="1column">
    <head>
        <title>Create New Customer Account</title>
        <css src="Magento_Customer::css/pv-login.css"/>
    </head>
    <body>
        <referenceBlock name="customer_form_register" remove="true"/>
        <referenceContainer name="content">
            <block class="Magento\Customer\Block\Form\Login"
                   name="customer_form_register_pvmodern"
                   template="Magento_Customer::form/login.phtml">
                <arguments>
                    <argument name="initial_view" xsi:type="string">signup</argument>
                </arguments>
                <container name="form.additional.info" as="form_additional_info"/>
            </block>
        </referenceContainer>
    </body>
</page>
