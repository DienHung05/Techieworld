}
function fmtDate(d) {
  if (!d) return '—';
  var dt = new Date(d.replace(' ', 'T'));
  return isNaN(dt) ? d : dt.toLocaleString('vi-VN', {day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'});
}
function timeAgo(d) {
  var diff = Math.floor((Date.now() - new Date(d.replace(' ','T')).getTime()) / 1000);
  if (diff < 60)   return diff + 's trước';
  if (diff < 3600) return Math.floor(diff/60) + ' phút trước';
  if (diff < 86400)return Math.floor(diff/3600) + ' giờ trước';
  return Math.floor(diff/86400) + ' ngày trước';
}
function statusLabel(s) {
  return {pending:'Chờ TT', pending_review:'Chờ xét', paid:'Đã TT', failed:'Thất bại', expired:'Hết hạn'}[s] || s;
}
function methodLabel(m) {
  return {momo:'MoMo', vnpay:'VNPay', bank_qr:'Ngân hàng QR', card:'Visa/Card', cod:'COD'}[m] || m;
}
function methodBadge(m) {
  return '<span class="method-' + esc(m) + '">' + esc(methodLabel(m)) + '</span>';
}
function statusBadge(s) {
  return '<span class="pva-badge badge-' + esc(s) + '">' + esc(statusLabel(s)) + '</span>';
}

function toast(msg, type) {
  var wrap = document.getElementById('pvToasts');
  var el = document.createElement('div');
  el.className = 'pva-toast ' + (type === 'err' ? 'err' : 'ok');
  el.textContent = msg;
  wrap.appendChild(el);
  setTimeout(function(){ el.style.opacity='0'; el.style.transition='opacity .3s'; setTimeout(function(){el.remove()},300); }, 3000);
}

// ── Load orders ───────────────────────────────────────────────
function pvLoadOrders() {
  var tbody = document.getElementById('pvTbody');
  tbody.innerHTML = '<tr><td colspan="9" class="pva-loading"><span class="pva-spinner"></span>Đang tải...</td></tr>';
  var icon = document.getElementById('pvRefreshIcon');
  if (icon) { icon.style.display='inline-block'; icon.style.animation='spin .65s linear infinite'; }

  var params = new URLSearchParams({
    tab:    pvCurrentTab,
    method: document.getElementById('pvFilterMethod').value,
    date:   document.getElementById('pvFilterDate').value,
    search: document.getElementById('pvFilterSearch').value.trim(),
    form_key: FORM_KEY
  });

  fetch(ORDERS_URL + '?' + params.toString(), {credentials: 'same-origin'})
    .then(function(r){ if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
    .then(function(data) {
      pvOrders = data.orders || [];
      renderTable(pvOrders);
      if (data.stats) {
        document.getElementById('statPending').textContent = data.stats.pending_review || 0;
        document.getElementById('statPaid').textContent    = data.stats.paid || 0;
        document.getElementById('statTotal').textContent   = data.stats.total || 0;
        document.getElementById('tabBadge').textContent    = data.stats.pending_review || 0;
      }
    })
    .catch(function(){ tbody.innerHTML = '<tr><td colspan="9" style="text-align:center;padding:32px;color:#dc2626">Lỗi tải dữ liệu. Vui lòng thử lại.</td></tr>'; })
    .finally(function(){ if(icon){icon.style.animation='';} });
}

function pvLoadLog() {
  var wrap = document.getElementById('pvLogBody');
  wrap.innerHTML = '<div class="pva-loading"><span class="pva-spinner"></span>Đang tải...</div>';
  var date = document.getElementById('pvFilterDate').value || '';
  fetch(ORDERS_URL + '?tab=casso_log&date=' + encodeURIComponent(date) + '&form_key=' + FORM_KEY, {credentials: 'same-origin'})
    .then(function(r){ return r.json(); })
    .then(function(data) {
      var logs = data.verifications || [];
      if (!logs.length) { wrap.innerHTML = '<div class="pva-empty"><div class="pva-empty-icon">📋</div><p>Chưa có hoạt động nào.</p></div>'; return; }
      wrap.innerHTML = logs.map(function(l) {
        var srcClass = 'src-' + (l.source || '').replace('_','-');
        var srcLabel = {manual_admin:'👤 Admin thủ công', casso:'🏦 Casso tự động', customer_upload:'📤 KH tải ảnh', casso_unmatched:'⚠ Casso chưa khớp'}[l.source] || l.source;
        return '<div class="pva-log-item ' + esc(srcClass) + '">'
          + '<div style="display:flex;justify-content:space-between;align-items:center">'
          + '<strong>' + esc(srcLabel) + '</strong>'
          + '<span style="font-weight:700;color:#16a34a">' + (l.amount ? fmtAmt(l.amount) : '—') + '</span>'
          + '</div>'
          + '<div class="pva-log-meta">'
          + (l.transaction_id ? '<span>TxID: ' + esc(l.transaction_id) + '</span>' : '')
          + (l.admin_user ? '<span>Admin: ' + esc(l.admin_user) + '</span>' : '')
          + '<span>' + fmtDate(l.created_at) + '</span>'
          + (l.note ? '<span>' + esc((l.note || '').substring(0, 120)) + '</span>' : '')
          + '</div>'
          + '</div>';
      }).join('');
    })
    .catch(function(){ wrap.innerHTML = '<div style="padding:32px;color:#dc2626;text-align:center">Lỗi tải lịch sử.</div>'; });
}

function renderTable(orders) {
  var tbody = document.getElementById('pvTbody');
  if (!orders.length) {
    tbody.innerHTML = '<tr><td colspan="9"><div class="pva-empty"><div class="pva-empty-icon">📭</div><p style="font-size:15px;color:#475569;font-weight:600">Không có đơn nào</p><p>Không tìm thấy đơn hàng phù hợp với bộ lọc.</p></div></td></tr>';
    return;
  }
  tbody.innerHTML = orders.map(function(o) {
    var hasImg   = !!o.screenshot_url;
    var imgHtml  = hasImg
      ? '<img src="' + esc(SCREENSHOT_BASE) + '?id=' + esc(o.id) + '&_ts=' + Date.now() + '" class="pva-thumb" onclick="pvOpenModal(' + esc(o.id) + ')" alt="proof" title="Click để xem ảnh">'
      : '<span class="pva-no-img">Chưa có ảnh</span>';
    var canAct   = (o.payment_status === 'pending_review' || o.payment_status === 'pending');
    var isPaid   = o.payment_status === 'paid';
    var btnApprove  = canAct ? '<button class="pva-btn-approve" onclick="pvQuickApprove(' + o.id + ')">✓ Duyệt</button>' : '';
    var btnReject   = canAct ? '<button class="pva-btn-reject" onclick="pvQuickReject(' + o.id + ')">✕</button>' : '';
    var btnSimulate = (IS_MOCK_MODE && !isPaid) ? '<button class="pva-btn-simulate" onclick="pvSimulateWebhook(' + o.id + ')" title="Simulate Casso webhook (sandbox)">⚡ Sim</button>' : '';

    return '<tr id="pvRow' + o.id + '">'
      + '<td><input type="checkbox" class="pv-row-chk" data-id="' + esc(o.id) + '"></td>'
      + '<td><strong>#' + esc(o.magento_increment_id || o.id) + '</strong><br><span style="font-size:11px;color:#94a3b8">' + esc(o.transfer_code) + '</span></td>'
      + '<td>' + esc(o.customer_name) + '<br><span style="font-size:11px;color:#94a3b8">' + esc(o.customer_email) + '</span></td>'
      + '<td>' + methodBadge(o.payment_method) + '</td>'
      + '<td><span class="amt">' + fmtAmt(o.total_amount) + '</span></td>'
      + '<td>' + imgHtml + '</td>'
      + '<td style="font-size:12px;color:#64748b">' + esc(timeAgo(o.created_at)) + '</td>'
      + '<td>' + statusBadge(o.payment_status) + '</td>'
      + '<td><div class="pva-btn-row"><button class="pva-btn-detail" onclick="pvOpenModal(' + o.id + ')">👁 Chi tiết</button>' + btnApprove + btnReject + btnSimulate + '</div></td>'
      + '</tr>';
  }).join('');

  // Update today stat
  var today = new Date().toDateString();
  var todayCount = orders.filter(function(o){ return new Date(o.created_at.replace(' ','T')).toDateString() === today; }).length;
  document.getElementById('statToday').textContent = todayCount;
}

// ── Modal ─────────────────────────────────────────────────────
function pvOpenModal(orderId) {
  var o = pvOrders.find(function(x){ return parseInt(x.id) === parseInt(orderId); });
  if (!o) return;
  pvCurrentOrderId = o.id;

  document.getElementById('pvModalTitle').textContent = 'Đơn #' + (o.magento_increment_id || o.id) + ' — ' + methodLabel(o.payment_method);

  // Screenshot
  var wrap = document.getElementById('pvScreenshotWrap');
  if (o.screenshot_url) {
    wrap.innerHTML = '<img src="' + esc(SCREENSHOT_BASE) + '?id=' + esc(o.id) + '&_ts=' + Date.now() + '" alt="Payment proof" style="max-width:100%;max-height:440px;cursor:zoom-in" onclick="window.open(this.src)">';
  } else {
    wrap.innerHTML = '<div class="pva-screenshot-placeholder"><div style="font-size:36px;margin-bottom:8px">🖼</div><p>Khách hàng chưa tải ảnh lên</p></div>';
  }

  // Order details
  var amtStr = fmtAmt(o.total_amount);
  document.getElementById('pvMOrdId').textContent   = '#' + (o.magento_increment_id || o.id);
  document.getElementById('pvMCustomer').textContent = o.customer_name || '—';
  document.getElementById('pvMContact').textContent  = [o.customer_email, o.customer_phone].filter(Boolean).join(' / ') || '—';
  document.getElementById('pvMMethod').textContent   = methodLabel(o.payment_method);
  document.getElementById('pvMAmount').textContent   = amtStr;
  document.getElementById('pvMCreated').textContent  = fmtDate(o.created_at);
  document.getElementById('pvMExpires').textContent  = fmtDate(o.expires_at);
  document.getElementById('pvMStatus').innerHTML     = statusBadge(o.payment_status);
  document.getElementById('pvChkAmount').textContent = amtStr;
  document.getElementById('pvMNote').value = '';

  // Reset checklist
  [1,2,3,4,5].forEach(function(n){ document.getElementById('chk'+n).checked = false; });

  // Buttons
  var canAct = (o.payment_status === 'pending_review' || o.payment_status === 'pending');
  document.getElementById('pvFootApprove').disabled = !canAct;
  document.getElementById('pvFootReject').disabled  = (o.payment_status === 'paid' || o.payment_status === 'failed');
  document.getElementById('pvModalHint').textContent = canAct ? 'Tích đầy đủ checklist trước khi duyệt' : 'Đơn hàng này đã được xử lý (' + statusLabel(o.payment_status) + ')';

  document.getElementById('pvModal').classList.add('open');
  document.body.style.overflow = 'hidden';
}

function pvCloseModal() {
  document.getElementById('pvModal').classList.remove('open');
  document.body.style.overflow = '';
  pvCurrentOrderId = null;
}

function pvToggleCheck(item) {
  var cb = item.querySelector('input[type=checkbox]');
  if (cb) cb.checked = !cb.checked;
}

function pvModalAction(action) {
  if (!pvCurrentOrderId) return;
  var note = document.getElementById('pvMNote').value.trim();
  pvDoAction(pvCurrentOrderId, action, note, function(){ pvCloseModal(); });
}

// ── Quick actions ─────────────────────────────────────────────
function pvQuickApprove(orderId) {
  if (!confirm('Xác nhận duyệt thanh toán cho đơn này?')) return;
  pvDoAction(orderId, 'approve', '', null);
}
function pvQuickReject(orderId) {
  var note = prompt('Lý do từ chối (tùy chọn):') || '';
  pvDoAction(orderId, 'reject', note, null);
}

function pvSimulateWebhook(orderId) {
  if (!confirm('Simulate Casso webhook for order #' + orderId + '?\nThis will mark the order as paid (sandbox only).')) return;
  var url = SIMULATE_URL + (SIMULATE_URL.indexOf('?') >= 0 ? '&' : '?') + 'form_key=' + encodeURIComponent(FORM_KEY);
  fetch(url, {
    method: 'POST',
    credentials: 'same-origin',
    headers: {'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest'},
    body: JSON.stringify({pv_order_id: orderId, form_key: FORM_KEY})
  })
  .then(function(r){ return r.json(); })
  .then(function(data) {
    if (data.success) {
      toast('⚡ Simulated! Status: ' + (data.payment_status || '?'), 'ok');
      pvLoadOrders();
    } else {
      toast('Simulate failed: ' + (data.message || 'Unknown error'), 'err');
    }
  })
  .catch(function(err){ toast('Lỗi: ' + (err.message || 'Request failed'), 'err'); });
}

function pvDoAction(orderId, action, note, cb) {
  var baseUrl = action === 'approve' ? APPROVE_URL : REJECT_URL;
  var url = baseUrl + (baseUrl.indexOf('?') >= 0 ? '&' : '?') + 'form_key=' + encodeURIComponent(FORM_KEY);
  fetch(url, {
    method: 'POST',
    credentials: 'same-origin',
    headers: {'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest'},
    body: JSON.stringify({id: orderId, note: note, form_key: FORM_KEY})
  })
  .then(function(r){
    if (!r.ok) { throw new Error('HTTP ' + r.status); }
    return r.json();
  })
  .then(function(data) {
    if (data.success) {
      toast(data.message || (action === 'approve' ? '✓ Đã duyệt' : '✕ Đã từ chối'), 'ok');
      if (cb) cb();
      pvLoadOrders();
    } else {
      toast('Lỗi: ' + (data.message || 'Unknown error'), 'err');
    }
  })
  .catch(function(err){ toast('Lỗi: ' + (err.message || 'Kết nối thất bại. Vui lòng tải lại trang.'), 'err'); });
}

// ── Tab switching ─────────────────────────────────────────────
document.querySelectorAll('.pva-tab').forEach(function(tab) {
  tab.addEventListener('click', function() {
    document.querySelectorAll('.pva-tab').forEach(function(t){ t.classList.remove('active'); });
    tab.classList.add('active');
    pvCurrentTab = tab.dataset.tab;
    if (pvCurrentTab === 'log') {
      document.getElementById('pvOrdersPanel').style.display = 'none';
      document.getElementById('pvLogPanel').style.display = '';
      pvLoadLog();
    } else {
      document.getElementById('pvOrdersPanel').style.display = '';
      document.getElementById('pvLogPanel').style.display = 'none';
      pvLoadOrders();
    }
  });
});

// ── Select all ────────────────────────────────────────────────
document.getElementById('pvCheckAll').addEventListener('change', function() {
  document.querySelectorAll('.pv-row-chk').forEach(function(c){ c.checked = document.getElementById('pvCheckAll').checked; });
});

// ── Filter events ─────────────────────────────────────────────
document.getElementById('pvFilterMethod').addEventListener('change', pvLoadOrders);
document.getElementById('pvFilterDate').addEventListener('change', pvLoadOrders);
document.getElementById('pvFilterSearch').addEventListener('input', function() {
  var self = this;
  clearTimeout(self._t);
  self._t = setTimeout(pvLoadOrders, 380);
});

// ── Close modal on backdrop click ─────────────────────────────
document.getElementById('pvModal').addEventListener('click', function(e) {
  if (e.target === this) pvCloseModal();
});
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') pvCloseModal();
});

// ── Auto-refresh every 30s on pending_review tab ──────────────
function scheduleAutoRefresh() {
  clearTimeout(pvAutoTimer);
  pvAutoTimer = setTimeout(function() {
    if (pvCurrentTab === 'pending_review') pvLoadOrders();
    scheduleAutoRefresh();
  }, 30000);
}
scheduleAutoRefresh();

// ── Initial load ──────────────────────────────────────────────
pvLoadOrders();

window.pvOpenModal   = pvOpenModal;
window.pvCloseModal  = pvCloseModal;
window.pvToggleCheck = pvToggleCheck;
window.pvModalAction = pvModalAction;
window.pvQuickApprove    = pvQuickApprove;
window.pvQuickReject     = pvQuickReject;
window.pvSimulateWebhook = pvSimulateWebhook;
window.pvLoadOrders      = pvLoadOrders;

})();
</script>
