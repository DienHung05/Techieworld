# PVModern runtime config — secrets and feature flags.
# Loaded by YourVendor\PVModern\Model\IntegrationConfig.
# Lines starting with # are comments. KEY=value (no spaces around =).

# --- Casso webhook (legacy, kept for backwards-compat) ---
CASSO_WEBHOOK_SECRET=bnfAtEvz1tUtQERyfFu7AAfWcvN3F6FMCAezHoHCVnYAjB8IRrx32QZcfR5tSi2j
CASSO_SANDBOX_MODE=false

# --- SePay webhook ---
# This site runs in PERMANENT SANDBOX MODE. Real customer transfers will NOT
# auto-confirm — payment is simulated via SePay's Test Mode dashboard. The
# storefront renders a "DEMO MODE" badge at step 4 to make this obvious.
#
# SePay sends "Authorization: Apikey <SEPAY_API_KEY>" with each webhook POST.
# Our endpoint accepts BOTH keys, so you can flip back to live by setting
# PVMODERN_PAYMENT_DEMO=false without touching anything else.
SEPAY_API_KEY=3e1dbcdb2f0d17f13172fe4ddc97e55269464d8a8b68ed79178e4a64b347f042
SEPAY_SANDBOX_API_KEY=ZJY4BNNGX8SQW08LBPDAYU2PJAFKMEEXA1QOGESUTDMLRCWZQQUCTRJYIPYFFOVM
SEPAY_SANDBOX_MODE=false

# When true:
#   1. Step-4 page shows a visible DEMO MODE banner
#   2. The QR code encodes a URL (not bank-transfer EMV), so scanning it with
#      any phone camera opens https://<host>/api/qr/scan-paid?order=ORDxxx
#      → that endpoint flips the order to paid → SSE pushes the open browser
#      tab to step 5 within ~3 seconds
# Flip to false only when ready to take real payments.
PVMODERN_PAYMENT_DEMO=true

# Absolute public URL of this site, used when generating QR codes that need
# to be scanned by a phone. The phone can't resolve relative URLs, and
# can't reach a 127.0.0.1 baked into the request. Set this to whatever URL
# customers use to view the storefront. Leave blank to auto-detect from
# the HTTP request host header (works for same-network phones on LAN/ZeroTier).
PVMODERN_PUBLIC_BASE_URL=https://techieworld.site

# --- SePay pull-API (active resilience path) ---
# Personal-account webhook delivery on Free tier is unreliable, so the SSE
# stream ALSO actively pulls SePay's UserAPI every 3 seconds for matching
# transactions. Generate this token at https://my.sepay.vn → Cài đặt → API Access.
# Header sent on each pull: "Authorization: Bearer <SEPAY_API_TOKEN>".
SEPAY_API_TOKEN=AGBTLIMIRV6ZWULDFP4RZUCE17SNB3CFM3X5YNKT2NWMTLAJDQFC0ZWPQRCAXDI9

# --- Payment provider mock fallbacks ---
# false = live MoMo/VNPay/Stripe APIs when credentials present;
# true  = always render BIDV VietQR fallback (no real money paths).
PVMODERN_PAYMENT_MOCK=false
PVMODERN_CHECKOUT_MOCK=false

# --- VNPay sandbox ---
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=2TYVDOZQ
VNPAY_HASH_SECRET=X0EXY6CKSX9CNUEMS6M7KYEOH7WXWNX6
VNPAY_RETURN_URL=https://techieworld.site/pvmodern/checkout/vnpayReturn
VNPAY_IPN_URL=https://techieworld.site/api/webhooks_vnpay/ipn
VNPAY_LOCALE=vn
VNPAY_EXPIRE_MINUTES=30

# --- PayPal sandbox ---
# This is the sandbox merchant/business account used to build PayPal sandbox
# redirect URLs. Do not put the PayPal login password here; PayPal API
# credentials are separate values from the developer dashboard.
PAYPAL_BUSINESS_ACCOUNT=sb-lyr5b51523240@business.example.com
# Optional: sandbox Personal buyer email from PayPal Developer Dashboard.
# This is shown as a checkout hint only; the buyer still logs in on PayPal.
PAYPAL_PERSONAL_ACCOUNT=sb-i337u51529067@personal.example.com
PAYPAL_PAYMENT_URL=https://www.sandbox.paypal.com/cgi-bin/webscr
PAYPAL_IPN_VERIFY_URL=https://ipnpb.sandbox.paypal.com/cgi-bin/webscr
PAYPAL_RETURN_URL=https://techieworld.site/pvmodern/checkout/paypalReturn
PAYPAL_CANCEL_URL=https://techieworld.site/payment-confirmation
PAYPAL_NOTIFY_URL=https://techieworld.site/api/webhooks/paypalIpn
PAYPAL_CURRENCY=USD
PAYPAL_VND_TO_USD_RATE=25000

